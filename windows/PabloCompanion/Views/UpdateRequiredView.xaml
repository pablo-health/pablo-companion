<UserControl
    x:Class="PabloCompanion.Views.UpdateRequiredView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Blocking full-window screen for a version mismatch. Mirrors
         UpdateRequiredView.swift: no dismiss, no bypass. Windows adds an Update
         button (the Mac has Sparkle) that opens the app's Store page. -->
    <Grid Background="{StaticResource PabloCream}">
        <StackPanel Spacing="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="400"
                    Padding="32">

            <Border CornerRadius="24"
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                <Border.Background>
                    <ImageBrush ImageSource="ms-appx:///Images/PabloBear.png"
                                Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource PabloDisplayMedium}"
                       Foreground="{StaticResource PabloBrownDeep}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />

            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource PabloBodyMedium}"
                       Foreground="{StaticResource PabloBrownSoft}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="InstructionText"
                       Style="{StaticResource PabloBodyMedium}"
                       Foreground="{StaticResource PabloBrownSoft}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Button x:Name="UpdateButton"
                    Content="Update"
                    Click="Update_Click"
                    Style="{StaticResource PabloPrimaryButton}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Update Pablo in the Microsoft Store" />
        </StackPanel>
    </Grid>
</UserControl>

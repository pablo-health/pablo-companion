<UserControl
    x:Class="PabloCompanion.Views.RecordingTroubleNote"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shown in the session card when audio isn't being recorded: capture has
         stalled, or has stopped while the session is still open. Offers one fix,
         restarting capture, which keeps what was already recorded and adds to it.
         Mirrors RecordingTroubleNote.swift. -->
    <Border Background="{StaticResource PabloCream}"
            BorderBrush="{StaticResource PabloError}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      Glyph="&#xE7BA;"
                      FontSize="18"
                      Foreground="{StaticResource PabloError}"
                      VerticalAlignment="Top"
                      AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource PabloBodyMedium}"
                           Foreground="{StaticResource PabloBrownDeep}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton x:Name="RestartButton"
                                     Content="Restart Recording"
                                     Padding="0"
                                     Click="RestartButton_Click"
                                     AutomationProperties.Name="Restart recording" />
                    <HyperlinkButton x:Name="OpenSettingsButton"
                                     Content="Open Settings"
                                     Padding="0"
                                     Visibility="Collapsed"
                                     Click="OpenSettingsButton_Click"
                                     AutomationProperties.Name="Open microphone privacy settings" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

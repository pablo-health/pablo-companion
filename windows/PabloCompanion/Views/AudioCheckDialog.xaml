<ContentDialog
    x:Class="PabloCompanion.Views.AudioCheckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Say hello to Pablo"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    SecondaryButtonClick="Secondary_Click"
    CloseButtonClick="Close_Click">

    <StackPanel Spacing="20" Width="380" Padding="0,8,0,0">
        <Border CornerRadius="48"
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw">
            <Border.Background>
                <ImageBrush ImageSource="ms-appx:///Images/PabloBear.png"
                            Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <StackPanel Spacing="8">
            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource PabloDisplayMedium}"
                       Foreground="{StaticResource PabloBrownDeep}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="CaptionText"
                       Style="{StaticResource PabloBodyMedium}"
                       Foreground="{StaticResource PabloBrownSoft}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="ChecksPanel" Spacing="10" Visibility="Collapsed">
            <StackPanel x:Name="ComputerRow" Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ComputerIcon"
                          FontSize="16"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="ComputerText"
                           Style="{StaticResource PabloBodyMedium}"
                           Foreground="{StaticResource PabloBrownDeep}"
                           TextWrapping="Wrap"
                           MaxWidth="340" />
            </StackPanel>
            <StackPanel x:Name="YouRow" Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="YouIcon"
                          FontSize="16"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="YouText"
                           Style="{StaticResource PabloBodyMedium}"
                           Foreground="{StaticResource PabloBrownDeep}"
                           TextWrapping="Wrap"
                           MaxWidth="340" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ContentDialog>

<UserControl
    x:Class="PabloCompanion.Views.MinimalShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PabloCompanion.Views">

    <!-- Session-first main window: today's next appointment with Start Session
         and the live recording controls, a web-dashboard handoff, and a footer
         (status / preferences / sign-out / version). Mirrors MinimalMainView.swift. -->
    <Grid Background="{StaticResource PabloCream}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="0,20,0,16">

                <!-- Header -->
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            Padding="24,0">
                    <Border CornerRadius="16"
                            Width="68"
                            Height="68"
                            AutomationProperties.AccessibilityView="Raw">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Images/PabloBear.png"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Pablo Companion"
                                   Style="{StaticResource PabloDisplayMedium}"
                                   FontWeight="Bold" />
                        <TextBlock Text="Pablo's ready for your next session."
                                   Style="{StaticResource PabloBodyMedium}"
                                   Foreground="{StaticResource PabloBrownSoft}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10" Padding="32,0">
                    <!-- Recording on another device (informational only) -->
                    <Border x:Name="ElsewhereNote"
                            Background="#1A7A9E7E"
                            CornerRadius="8"
                            Padding="12,8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C8;"
                                      FontSize="12"
                                      Foreground="{StaticResource PabloSage}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ElsewhereText"
                                       Style="{StaticResource PabloBodySmall}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Why the last Start Session didn't get a recording going -->
                    <InfoBar x:Name="StartErrorBar"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="True"
                             Closed="StartErrorBar_Closed">
                        <InfoBar.ActionButton>
                            <HyperlinkButton x:Name="OpenMicSettingsButton"
                                             Content="Open Settings"
                                             Click="OpenMicSettings_Click"
                                             AutomationProperties.Name="Open microphone privacy settings" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Next appointment / live recording -->
                    <local:AppointmentCard x:Name="Card"
                                           Visibility="Collapsed" />

                    <!-- Loading -->
                    <StackPanel x:Name="LoadingCard"
                                Orientation="Horizontal"
                                Spacing="10"
                                Padding="16"
                                Visibility="Collapsed">
                        <ProgressRing IsActive="True"
                                      Width="16"
                                      Height="16"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Checking today's appointments..."
                                   Style="{StaticResource PabloBodyMedium}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Load failed -->
                    <Border x:Name="ErrorCard"
                            Background="#1AC45B4A"
                            CornerRadius="12"
                            Padding="16"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="14"
                                          Foreground="{StaticResource PabloError}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Pablo couldn't load today's appointments."
                                           Style="{StaticResource PabloBodyMedium}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Try Again"
                                    Click="TryAgain_Click"
                                    Style="{StaticResource PabloSecondaryButton}"
                                    AutomationProperties.Name="Try loading today's appointments again" />
                        </StackPanel>
                    </Border>

                    <!-- Nothing left today -->
                    <Border x:Name="NoUpcomingCard"
                            Background="#1F7A9E7E"
                            CornerRadius="12"
                            Padding="16"
                            Visibility="Collapsed"
                            AutomationProperties.Name="No upcoming appointments for today">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border CornerRadius="36"
                                    Width="72"
                                    Height="72"
                                    AutomationProperties.AccessibilityView="Raw">
                                <Border.Background>
                                    <ImageBrush ImageSource="ms-appx:///Images/PabloBear.png"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="No upcoming appointments for today"
                                           FontFamily="{StaticResource PabloDisplayFont}"
                                           FontSize="16"
                                           Foreground="{StaticResource PabloBrownDeep}"
                                           TextWrapping="Wrap"
                                           MaxWidth="260" />
                                <TextBlock Text="Pablo's got it."
                                           Style="{StaticResource PabloBodySmall}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Session audio that hasn't uploaded yet -->
                    <local:UploadBacklogNote x:Name="BacklogNote"
                                             Visibility="Collapsed" />
                </StackPanel>

                <Button Content="Open Web Dashboard"
                        Click="OpenDashboard_Click"
                        Style="{StaticResource PabloSecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Margin="32,0"
                        AutomationProperties.Name="Open the Pablo web dashboard in your browser" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: status, then preferences / sign-out / version -->
        <StackPanel Grid.Row="1"
                    Spacing="10"
                    Padding="24,12"
                    Background="#59FFFFFF">
            <StackPanel Spacing="6">
                <!-- Connection status: dot + "Connected to <host> as <email>" -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource PabloSage}"
                             AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource PabloBodySmall}"
                               Foreground="{StaticResource PabloBrownDeep}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400" />
                </StackPanel>

                <!-- Mic-ready indicator -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="MicDot"
                             Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource PabloSage}"
                             AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="MicText"
                               Style="{StaticResource PabloBodySmall}"
                               Foreground="{StaticResource PabloBrownDeep}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#1A2C1810" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <HyperlinkButton Content="Preferences"
                                     Click="Preferences_Click"
                                     AutomationProperties.Name="Open preferences" />
                    <HyperlinkButton Content="Sign out"
                                     Click="SignOut_Click"
                                     AutomationProperties.Name="Sign out" />
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           Grid.Column="1"
                           Style="{StaticResource PabloBodySmall}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
